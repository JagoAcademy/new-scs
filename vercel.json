{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/tiket",
      "destination": "/tiket.html"
    },
    {
      "source": "/pitch/:brand",
      "destination": "/pitch-client?brand=:brand"
    },
    {
      "source": "/((?!api/|assets/|src/|images/|pitch|pitch-client|.*\\..*).*)",
      "destination": "/event-public"
    }
  ]
}