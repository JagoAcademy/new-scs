{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/pitch/:brand",
      "destination": "/pitch-client.html?brand=:brand"
    },
    {
      "source": "/((?!api/|assets/|src/|images/|pitch/|pitch-client|.*\\..*).*)",
      "destination": "/event-public.html"
    }
  ]
}
